   "source": [
    "# SECTION 4: UNIVARIATE ANALYSIS\n",
    "\n",
    "## 4.1 Popularity Distribution\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "\n",
    "sns.histplot(df_clean['popularity'], bins=30, kde=True, ax=axes[0], color='#1DB954')\n",
