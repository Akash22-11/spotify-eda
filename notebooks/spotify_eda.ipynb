    "# SECTION 1: ENVIRONMENT SETUP\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Style configuration\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams['figure.figsize'] = (12, 6)\n",
    "plt.rcParams['font.size'] = 11\n",
    "plt.rcParams['axes.edgecolor'] = '#cccccc'\n",
    "plt.rcParams['axes.linewidth'] = 0.8\n",
    "\n",
    "DATA_PATH = r\"../data/spotify.csv\"\n",
    "VISUALS_DIR = r\"../visuals\"\n",
    "REPORTS_DIR = r\"../reports\"\n",
    "\n",
    "print(\"Environment ready. Libraries loaded.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SECTION 2: DATA UNDERSTANDING\n",
    "df = pd.read_csv(DATA_PATH)\n",
    "print(\"=== DATASET SHAPE ===\")\n",
    "print(f\"Rows: {df.shape[0]:,}, Columns: {df.shape[1]}\")\n",
    "\n",
    "print(\"\\n=== COLUMNS ===\")\n",
    "print(list(df.columns))\n",
    "\n",
    "print(\"\\n=== DATA TYPES ===\")\n",
    "print(df.dtypes)\n",
    "\n",
    "print(\"\\n=== FIRST 5 ROWS ===\")\n",
    "display(df.head())\n",
    "\n",
    "print(\"\\n=== MISSING VALUES ===\")\n",
    "missing = df.isnull().sum()\n",
    "missing_pct = (df.isnull().mean() * 100).round(2)\n",
    "missing_df = pd.DataFrame({'Missing_Count': missing, 'Missing_Pct': missing_pct})\n",
    "display(missing_df[missing_df['Missing_Count'] > 0])\n",
    "\n",
    "print(\"\\n=== DUPLICATE ANALYSIS ===\")\n",
    "print(f\"Full row duplicates: {df.duplicated().sum()}\")\n",
    "print(f\"Duplicate track_ids: {df['track_id'].duplicated().sum()}\")\n",
    "\n",
    "print(\"\\n=== STATISTICAL SUMMARY (Numerical) ===\")\n",
    "display(df.describe())\n",
    "\n",
    "print(\"\\n=== CATEGORICAL SUMMARY ===\")\n",
    "cat_cols = df.select_dtypes(include=['object', 'bool']).columns\n",
    "for col in cat_cols:\n",
    "    print(f\"{col}: {df[col].nunique()} unique values\")\n",
    "    if df[col].nunique() < 20:\n",
    "        print(f\"  Values: {df[col].value_counts().to_dict()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SECTION 3: DATA CLEANING\n",
    "df_clean = df.copy()\n",
    "\n",
    "# Drop unnamed index column\n",
    "if 'Unnamed: 0' in df_clean.columns:\n",
    "    df_clean = df_clean.drop(columns=['Unnamed: 0'])\n",
    "\n",
    "# Handle missing values\n",
    "print(\"Missing before cleaning:\", df_clean[['artists', 'album_name', 'track_name']].isnull().sum().to_dict())\n",
    "df_clean = df_clean.dropna(subset=['artists', 'album_name', 'track_name'])\n",
    "\n",
    "# Remove duplicate track_ids (keep first occurrence)\n",
    "dup_before = df_clean['track_id'].duplicated().sum()\n",
    "df_clean = df_clean.drop_duplicates(subset=['track_id'], keep='first')\n",
    "dup_after = df_clean['track_id'].duplicated().sum()\n",
    "print(f\"Duplicate track_ids removed: {dup_before - dup_after}\")\n",
    "\n",
    "# Feature engineering\n",
    "df_clean['duration_min'] = df_clean['duration_ms'] / 60000.0\n",
    "df_clean['duration_sec'] = df_clean['duration_ms'] / 1000.0\n",
    "\n",
    "# Key name mapping\n",
    "key_map = {0:'C', 1:'C#', 2:'D', 3:'D#', 4:'E', 5:'F', 6:'F#', 7:'G', 8:'G#', 9:'A', 10:'A#', 11:'B'}\n",
    "df_clean['key_name'] = df_clean['key'].map(key_map)\n",
    "\n",
    "# Mode name mapping\n",
    "df_clean['mode_name'] = df_clean['mode'].map({0:'Minor', 1:'Major'})\n",
    "\n",
    "# Dance-Energy interaction groups\n",
    "df_clean['dance_energy_group'] = 'Low Both'\n",
    "df_clean.loc[(df_clean['danceability'] > 0.6) & (df_clean['energy'] > 0.6), 'dance_energy_group'] = 'High Both'\n",
    "df_clean.loc[(df_clean['danceability'] > 0.6) & (df_clean['energy'] <= 0.6), 'dance_energy_group'] = 'High Dance / Low Energy'\n",
    "df_clean.loc[(df_clean['danceability'] <= 0.6) & (df_clean['energy'] > 0.6), 'dance_energy_group'] = 'Low Dance / High Energy'\n",
    "\n",
    "print(f\"\\n=== CLEANED DATASET SHAPE: {df_clean.shape} ===\")\n",
    "print(\"\\n=== CLEANED DATA TYPES ===\")\n",
    "print(df_clean.dtypes)\n",
    "\n",
    "print(\"\\n=== SAMPLE OF CLEANED DATA ===\")\n",
    "display(df_clean.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
