    "# SECTION 6: MULTIVARIATE ANALYSIS\n",
    "\n",
    "## 6.1 Correlation Matrix & Heatmap\n",
    "num_cols = ['popularity', 'duration_ms', 'danceability', 'energy', 'key', 'loudness',\n",
    "            'mode', 'speechiness', 'acousticness', 'instrumentalness', 'liveness', 'valence', 'tempo']\n",
    "\n",
    "corr_matrix = df_clean[num_cols].corr()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 9))\n",
    "sns.heatmap(corr_matrix, annot=True, fmt=\".2f\", cmap=\"coolwarm\", center=0, ax=ax,\n",
    "           cbar_kws={'label': 'Pearson Correlation'})\n",
    "ax.set_title(\"Spotify Audio Features Correlation Heatmap\", fontsize=14, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(f\"{VISUALS_DIR}/10_correlation_heatmap.png\", dpi=300)\n",
    "plt.show()\n",
    "\n",
    "**Strongest Correlations with Popularity:**\n",
    f"1. **Loudness**: {corr_matrix.loc['popularity', 'loudness']:.3f}\n",
    f"2. **Energy**: {corr_matrix.loc['popularity', 'energy']:.3f}\n",
    f"3. **Acousticness**: {corr_matrix.loc['popularity', 'acousticness']:.3f} (negative)\n",
    f"4. **Danceability**: {corr_matrix.loc['popularity', 'danceability']:.3f}\n",
    "\n",
    "**Key Feature Inter-correlations:**\n",
